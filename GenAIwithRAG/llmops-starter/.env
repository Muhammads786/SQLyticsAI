# === Runtime configuration for LLMOps Starter ===

# Base URL of your LLM endpoint (vLLM, TGI, or Ollama)
# If you're running vLLM in Docker, keep as-is
OPENAI_BASE_URL=http://localhost:11434/v1

# If you're using Ollama on the host instead, use this instead:
# OPENAI_BASE_URL=http://host.docker.internal:11434/v1

# API key for local model (placeholder)
OPENAI_API_KEY=ollama

# Embedding model for document vectorization
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBED_MODEL=nomic-embed-text


# Name of your Qdrant collection
COLLECTION_NAME=docs

# Qdrant connection info
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# MLflow tracking server
MLFLOW_TRACKING_URI=http://localhost:5000

# RAG (Retrieval-Augmented Generation) configuration
RAG_TOP_K=4

# === Optional overrides ===
# Uncomment and edit if you deploy to cloud
# AWS_REGION=ap-southeast-2
# AZURE_OPENAI_ENDPOINT=https://your-openai-resource.openai.azure.com
# AZURE_OPENAI_KEY=your-azure-key
